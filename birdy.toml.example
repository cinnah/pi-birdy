# The web settings page rewrites birdy.toml without comments; this example keeps the documentation.
# Birdy configuration. Copy to birdy.toml and edit. Relative paths are
# resolved against the directory containing this file.

[site]
name = "home"
# Optional. Both or neither. With both set, capture pauses outside
# sunrise-margin .. sunset+margin. Without them, capture runs 24/7.
# lat = 38.72
# lon = -9.14

[camera]
main_size = [3280, 2464]   # full-res stills. Drop to [1640, 1232] if the
                           # camera fails to allocate buffers (CMA memory).
lores_size = [320, 240]    # analysis stream; ROI coordinates use this size
jpeg_quality = 90

[motion]
# Polygon around the feeder, in lores_size pixel coordinates.
# Run `birdy roi` to save a frame and pick the points.
roi = [[40, 60], [280, 60], [280, 220], [40, 220]]
pixel_threshold = 25       # per-pixel grey-level change to count as "changed"
min_area = 150             # changed pixels inside ROI needed to trigger
background_alpha = 0.05    # 0..1; higher = background adapts faster
cooldown_seconds = 3.0     # minimum gap between stills

[daylight]
margin_minutes = 30

[classifier]
model = "models/mobilenet_v2_1.0_224_quant.tflite"
labels = "models/imagenet_labels.txt"
bird_classes = "models/imagenet_bird_classes.txt"
threshold = 0.5            # P(bird) at or above this = bird

[species]
model = "models/mobilenet_v2_1.0_224_inat_bird_quant.tflite"
labels = "models/inat_bird_labels.txt"
threshold = 0.5            # show a species name at or above this confidence
rescue_threshold = 0.7     # a frame the gate rejected becomes a bird if the species model is this sure

[retention]
non_bird_days = 7          # non-bird photos older than this are deleted hourly

[storage]
data_dir = "data"          # photos/, thumbs/, birdy.db live here

[web]
host = "0.0.0.0"
port = 8000

[telegram]
enabled = false            # restart-only; set true once bot_token and chat_id are filled in
bot_token = ""             # restart-only, SECRET — from @BotFather; this file is gitignored
chat_id = ""               # restart-only — `birdy telegram-chat-id` prints it after you message the bot
base_url = "http://birdy.local:8000"   # link in the alert caption
watchlist = []             # species common names (as on /species), e.g. ["Eurasian Hoopoe"]
alert_new_species = true   # one alert the first time any species is ever seen
cooldown_minutes = 30      # at most one alert per species per this many minutes

[publish]
# Public gallery (https://birdy.akibeo.com). The Pi rsyncs web-sized copies of its best
# bird photos to the server; see CLAUDE.md "Gallery setup".
enabled = false                   # restart-only; when false nothing is published
host = ""                         # restart-only; the gallery server, e.g. "91.98.229.209"
user = "birdy"                    # restart-only; SSH user on the server
remote_dir = "/"                  # restart-only; rsync target as the server key sees it: "/" with the
                                  # rrsync-restricted key, or the full path if the key is unrestricted
site_id = "home"                  # restart-only; this site's id: folder under sites/ and id in sites.json; [a-z0-9-]{1,32}
ssh_key = "~/.ssh/birdy_publish"  # restart-only; private key (install.sh generates it)
min_confidence = 0.6              # live; species confidence needed to be auto-published (0-1)
per_species_per_day = 3           # live; best N photos per species per local day (1-20)
